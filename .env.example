# ============================================================
#  Creative Lab DZ - configuration
#  Copie ce fichier en `.env.local` et remplis tes valeurs.
# ============================================================

# --- OBLIGATOIRE ---------------------------------------------
# Cle API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modele utilise pour l analyse.
#   claude-sonnet-5 -> defaut. ~33 DA de cout par analyse video : c est ce qui
#                      rend les abonnements rentables.
#   claude-opus-5   -> analyse plus fouillee mais ~159 DA par video, soit une
#                      marge negative sur les paliers Essentiel et Pro.
ANTHROPIC_MODEL=claude-sonnet-5

# Profondeur de raisonnement du modele. C est le principal levier sur la duree.
# Laisser vide : chaque etape utilise le niveau qui lui convient (recommande).
# low | medium | high | xhigh | max  -> force le meme niveau partout, plus lent.
ANTHROPIC_EFFORT=

# --- TRANSCRIPTION (optionnel) --------------------------------
# Moteur de transcription de la voix off :
#   auto   -> sous-titres de la plateforme, puis Whisper local, puis lecture visuelle (defaut)
#   local  -> force Whisper local (@huggingface/transformers)
#   groq   -> API Groq (Whisper large-v3, tres rapide et bon marche)
#   openai -> API OpenAI (whisper-1)
#   none   -> pas de transcription audio, Claude lit les sous-titres a l'ecran
TRANSCRIBER=auto

# Modele Whisper local. tiny < base < small < medium (qualite et lenteur croissantes)
WHISPER_LOCAL_MODEL=Xenova/whisper-small

# Seulement si TRANSCRIBER=groq
GROQ_API_KEY=

# Seulement si TRANSCRIBER=openai
OPENAI_API_KEY=

# --- PIPELINE (optionnel) -------------------------------------
# Nombre max de keyframes envoyees a Claude (10-30 conseille).
MAX_FRAMES=20

# Duree max de video traitee, en secondes.
MAX_VIDEO_SECONDS=180

# Cookies navigateur pour les videos privees / Instagram exigeant une session.
# Ex : chrome, firefox, edge   (laisser vide pour desactiver)
YTDLP_COOKIES_FROM_BROWSER=

# --- MARCHE ALGERIEN (optionnel) ------------------------------
# Taux de change utilise pour les estimations de prix.
# Officiel ~ 130 DZD/USD, marche parallele (square) ~ 250 DZD/USD.
USD_TO_DZD_OFFICIAL=132
USD_TO_DZD_PARALLEL=252

# --- Espace admin ---
ADMIN_MOT_DE_PASSE=
ADMIN_SECRET=

# --- Pixels publicitaires ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

NEXT_PUBLIC_WHATSAPP=
