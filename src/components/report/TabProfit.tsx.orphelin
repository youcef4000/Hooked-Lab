"use client";

import { useMemo, useState } from "react";
import { Badge, Card } from "./ui";
import { calculerRentabilite, formatDZD, type ParamsCOD } from "@/lib/dz";
import type { Report } from "@/types/analysis";

function Curseur({
  label,
  aide,
  valeur,
  min,
  max,
  pas,
  suffixe,
  onChange,
}: {
  label: string;
  aide?: string;
  valeur: number;
  min: number;
  max: number;
  pas: number;
  suffixe: string;
  onChange: (v: number) => void;
}) {
  return (
    <div>
      <div className="flex items-baseline justify-between gap-2">
        <label className="text-[12px] text-ink-300">{label}</label>
        <div className="flex items-center gap-1.5">
          <input
            type="number"
            value={valeur}
            min={min}
            max={max}
            step={pas}
            onChange={(e) => {
              const v = Number(e.target.value);
              if (Number.isFinite(v)) onChange(v);
            }}
            className="w-24 rounded-md border border-ink-700 bg-ink-900 px-2 py-1 text-right font-mono text-[12px] tabular-nums outline-none focus:border-brand-500/60"
          />
          <span className="w-8 text-[11px] text-ink-500">{suffixe}</span>
        </div>
      </div>
      <input
        type="range"
        value={valeur}
        min={min}
        max={max}
        step={pas}
        onChange={(e) => onChange(Number(e.target.value))}
        className="mt-1.5 w-full accent-brand-500"
      />
      {aide && <p className="mt-0.5 text-[11px] leading-snug text-ink-500">{aide}</p>}
    </div>
  );
}

function Ligne({
  label,
  valeur,
  negatif,
  fort,
}: {
  label: string;
  valeur: string;
  negatif?: boolean;
  fort?: boolean;
}) {
  return (
    <div
      className={`flex items-baseline justify-between gap-3 py-1.5 ${fort ? "border-t border-ink-700 pt-2.5" : ""}`}
    >
      <span className={fort ? "text-[13px] font-medium" : "text-[13px] text-ink-300"}>{label}</span>
      <span
        className={`font-mono text-[13px] tabular-nums ${
          fort ? "text-[15px] font-semibold" : negatif ? "text-red-300/80" : "text-ink-100"
        }`}
      >
        {negatif ? "−" : ""}
        {valeur}
      </span>
    </div>
  );
}

export default function TabProfit({ report }: { report: Report }) {
  const [params, setParams] = useState<ParamsCOD>(report.rentabilite.params);
  const calcul = useMemo(() => calculerRentabilite(params), [params]);
  const r = calcul.resultats;

  const set = (cle: keyof ParamsCOD) => (v: number) => setParams((p) => ({ ...p, [cle]: v }));
  const rentable = r.profit_net_dzd > 0;

  return (
    <div className="space-y-4">
      <Card
        titre="Calculateur de rentabilité COD"
        sousTitre="Simulation sur 100 commandes confirmées. Ajuste les curseurs avec tes vrais chiffres."
      >
        <div className="grid gap-6 lg:grid-cols-2">
          {/* ------------------------------------------------ parametres */}
          <div className="space-y-5">
            <div className="space-y-4">
              <p className="text-[11px] uppercase tracking-wide text-ink-400">Produit et prix</p>
              <Curseur
                label="Prix de vente en Algérie"
                valeur={params.prix_vente_dzd}
                min={500}
                max={30000}
                pas={100}
                suffixe="DA"
                onChange={set("prix_vente_dzd")}
              />
              <Curseur
                label="Coût d'achat unitaire"
                valeur={params.cout_produit_usd}
                min={0.2}
                max={80}
                pas={0.1}
                suffixe="$"
                onChange={set("cout_produit_usd")}
              />
              <Curseur
                label="Fret unitaire vers l'Algérie"
                valeur={params.fret_unitaire_usd}
                min={0}
                max={30}
                pas={0.1}
                suffixe="$"
                onChange={set("fret_unitaire_usd")}
              />
              <Curseur
                label="Taux de change"
                aide="Officiel ≈ 132 DA/$ · marche parallele (square) ≈ 252 DA/$"
                valeur={params.taux_change}
                min={100}
                max={400}
                pas={1}
                suffixe="DA/$"
                onChange={set("taux_change")}
              />
            </div>

            <div className="space-y-4 border-t border-ink-800 pt-4">
              <p className="text-[11px] uppercase tracking-wide text-ink-400">Logistique</p>
              <Curseur
                label="Frais de livraison moyens"
                aide="Stopdesk ≈ 450 DA · domicile ≈ 700 DA"
                valeur={params.frais_livraison_dzd}
                min={0}
                max={1600}
                pas={25}
                suffixe="DA"
                onChange={set("frais_livraison_dzd")}
              />
              <Curseur
                label="Taux de livraison réussie"
                aide="Realite du marche algérien : entre 55 % et 75 % selon le produit et la qualité de confirmation."
                valeur={Math.round(params.taux_livraison * 100)}
                min={20}
                max={100}
                pas={1}
                suffixe="%"
                onChange={(v) => setParams((p) => ({ ...p, taux_livraison: v / 100 }))}
              />
              <Curseur
                label="Coût d'un colis retourne"
                valeur={params.cout_retour_dzd}
                min={0}
                max={1200}
                pas={25}
                suffixe="DA"
                onChange={set("cout_retour_dzd")}
              />
              <Curseur
                label="Emballage et confirmation"
                valeur={params.frais_divers_dzd}
                min={0}
                max={500}
                pas={10}
                suffixe="DA"
                onChange={set("frais_divers_dzd")}
              />
            </div>

            <div className="space-y-4 border-t border-ink-800 pt-4">
              <p className="text-[11px] uppercase tracking-wide text-ink-400">Publicite</p>
              <Curseur
                label="Coût par commande confirmée (CPA)"
                valeur={params.cout_pub_par_commande_dzd}
                min={0}
                max={4000}
                pas={25}
                suffixe="DA"
                onChange={set("cout_pub_par_commande_dzd")}
              />
            </div>

            <button
              onClick={() => setParams(report.rentabilite.params)}
              className="rounded-lg border border-ink-700 px-3 py-1.5 text-[12px] text-ink-300 transition hover:text-ink-100"
            >
              Revenir aux valeurs estimees
            </button>
          </div>

          {/* -------------------------------------------------- resultats */}
          <div>
            <div
              className={`rounded-xl p-4 ring-1 ${
                rentable ? "bg-brand-500/10 ring-brand-500/25" : "bg-red-500/10 ring-red-500/25"
              }`}
            >
              <p className="text-[11px] uppercase tracking-wide text-ink-400">
                Profit net sur 100 commandes confirmees
              </p>
              <p
                className={`mt-1 text-3xl font-semibold tabular-nums ${
                  rentable ? "text-brand-300" : "text-red-300"
                }`}
              >
                {formatDZD(r.profit_net_dzd)}
              </p>
              <div className="mt-2 flex flex-wrap gap-2">
                <Badge tone={rentable ? "vert" : "rouge"}>
                  {formatDZD(r.profit_par_commande_dzd)} par commande
                </Badge>
                <Badge tone={r.marge_pct >= 25 ? "vert" : r.marge_pct >= 10 ? "ambre" : "rouge"}>
                  marge {r.marge_pct.toFixed(1)} %
                </Badge>
              </div>
            </div>

            <div className="mt-4 rounded-xl border border-ink-800 bg-ink-850/50 p-4">
              <Ligne
                label={`Chiffre d'affaires (${r.commandes_livrees} livrées)`}
                valeur={formatDZD(r.ca_dzd)}
              />
              <Ligne label="Coût marchandise" valeur={formatDZD(r.cout_marchandise_dzd)} negatif />
              <Ligne label="Frais de livraison" valeur={formatDZD(r.cout_livraison_dzd)} negatif />
              <Ligne
                label={`Colis retournes (${r.commandes_retournees})`}
                valeur={formatDZD(r.cout_retours_dzd)}
                negatif
              />
              <Ligne label="Budget publicitaire" valeur={formatDZD(r.cout_pub_dzd)} negatif />
              <Ligne label="Profit net" valeur={formatDZD(r.profit_net_dzd)} fort />
            </div>

            <div className="mt-4 grid gap-3 sm:grid-cols-2">
              <div className="rounded-xl border border-ink-800 bg-ink-850/50 p-3.5">
                <p className="text-[11px] uppercase tracking-wide text-ink-400">Coût de revient unitaire</p>
                <p className="mt-1 font-mono text-lg tabular-nums">
                  {formatDZD(r.cout_revient_unitaire_dzd)}
                </p>
                <p className="mt-0.5 text-[11px] text-ink-500">produit + fret, converti en dinars</p>
              </div>
              <div className="rounded-xl border border-ink-800 bg-ink-850/50 p-3.5">
                <p className="text-[11px] uppercase tracking-wide text-ink-400">CPA maximum</p>
                <p
                  className={`mt-1 font-mono text-lg tabular-nums ${
                    r.cpa_max_dzd > 0 ? "text-brand-300" : "text-red-300"
                  }`}
                >
                  {formatDZD(r.cpa_max_dzd)}
                </p>
                <p className="mt-0.5 text-[11px] text-ink-500">
                  au-dela, chaque commande te fait perdre de l&apos;argent
                </p>
              </div>
              <div className="rounded-xl border border-ink-800 bg-ink-850/50 p-3.5 sm:col-span-2">
                <p className="text-[11px] uppercase tracking-wide text-ink-400">
                  Seuil de rentabilité en taux de livraison
                </p>
                <p
                  className={`mt-1 font-mono text-lg tabular-nums ${
                    r.seuil_rentabilite_taux_livraison <= params.taux_livraison
                      ? "text-brand-300"
                      : "text-red-300"
                  }`}
                >
                  {r.seuil_rentabilite_taux_livraison > 1
                    ? "impossible a atteindre"
                    : `${(r.seuil_rentabilite_taux_livraison * 100).toFixed(1)} %`}
                </p>
                <p className="mt-0.5 text-[11px] leading-relaxed text-ink-500">
                  Sous ce taux de livraison, l&apos;operation est deficitaire avec les parametres
                  actuels. Tu es aujourd&apos;hui a {(params.taux_livraison * 100).toFixed(0)} %.
                </p>
              </div>
            </div>
          </div>
        </div>
      </Card>

      <Card titre="Comment lire ces chiffres">
        <ul className="space-y-2 text-[13px] leading-relaxed text-ink-300">
          <li className="flex gap-2.5">
            <span className="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-ink-600" />
            <span>
              Les colis retournes ne coutent que le transport aller-retour : la marchandise revient en
              stock et reste vendable. C&apos;est pour cela que le coût marchandise ne porte que sur les
              commandes livrées.
            </span>
          </li>
          <li className="flex gap-2.5">
            <span className="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-ink-600" />
            <span>
              Le budget publicitaire est compte sur les 100 commandes confirmees, pas seulement sur les
              livrées : tu paies la publicite avant de savoir si le client acceptera le colis.
            </span>
          </li>
          <li className="flex gap-2.5">
            <span className="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-ink-600" />
            <span>
              Le taux de livraison est le levier le plus puissant du modèle COD. Un appel de
              confirmation sérieux avant expedition vaut souvent plus que n&apos;importe quelle
              optimisation publicitaire.
            </span>
          </li>
          <li className="flex gap-2.5">
            <span className="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-ink-600" />
            <span>
              Les valeurs de depart sont des estimations produites par l&apos;IA et des moyennes de
              marche. Remplace-les par tes vrais tarifs transporteur et ton vrai CPA des que tu les
              connais.
            </span>
          </li>
        </ul>
      </Card>
    </div>
  );
}
